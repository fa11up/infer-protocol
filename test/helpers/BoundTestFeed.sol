pragma solidity 0.8.26;

import {ConfigurableSwarmFeed} from "./ConfigurableSwarmFeed.sol";

/// @notice A test feed bound to the PRODUCTION NhiFeed question, with an attester the suite holds.
/// @dev The prefix is a byte copy of NhiFeed.QUESTION_PREFIX (internal, and questionPolicy is pure, so
/// it cannot be read across contracts). OracleAskerBoundGas asserts the copy is exact by comparing
/// expectedQuestionHash against a real NhiFeed, so a regenerated prefix fails that test, not silently.
contract BoundTestFeed is ConfigurableSwarmFeed {
    bytes private constant PREFIX = hex"";

    constructor(address attester_, address relayer_, uint256 maxAge_, uint256 maxDeviationBps_)
        ConfigurableSwarmFeed(attester_, relayer_, 1, 3, maxAge_, maxDeviationBps_)
    {}

    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (PREFIX, 150, 1_200);
    }
}
