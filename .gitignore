out/
cache/
broadcast/
oracle/node_modules/
pilot/node_modules/
oracle/relayer.config.js

# The keeper moved to its own private repository (fa11up/imd-keeper). If a copy is ever cloned
# in here for convenience, it must not be committed back.
keeper/

# The wallet-connected interface lives under web/ (pulled in from launch-706, 2026-10-04). Its own
# web/.gitignore covers node_modules and dist, but belt-and-braces here too so a `git add web`
# from the repo root can never stage the dependency tree or the build output.
web/node_modules/
web/.vite/
# web/vite.config.ts sets outDir "../dist", so the built bundle lands at the REPO ROOT, not web/.
# We do not deploy the site from this repo (the plane does, from a launch repo), so the export is
# build output here and is not tracked. Rebuild with `cd web && npm ci && npm run build`.
/dist/

# browser-suite evidence (screenshots, results); regenerated by web/tests/browser.mjs
/docs/frontend/

# points CLI output
/points.json
/dist-public/
deploy/mainnet/out/*.json
deploy/mainnet/out/bodies/*.json
docs/oracle-guards/gt_minute.json
/dist-infer/
/dist-whitepaper/
/dist-blog/
test/scratch/

# The Etherscan API key for launch.sh verify: local only, never committed (this repo is public).
deploy/mainnet/.etherscan.local
__pycache__/
deploy/mainnet/out/safe/
